# ── Almacenamiento (Firestore) ────────────────────────────────────────────
# Cuenta de servicio de Firebase (Project settings → Service accounts → Generate new private key).
# Pega el JSON completo en UNA línea, o su versión base64. Vacío SOLO en desarrollo local: se usa un almacén
# en memoria con archivo en ./.data (en producción la app se niega a arrancar sin esto).
FIREBASE_SERVICE_ACCOUNT=
# Solo si usas el emulador de Firestore (FIRESTORE_EMULATOR_HOST=127.0.0.1:8080):
FIREBASE_PROJECT_ID=

# ── Secretos (genera cada uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))") ─
SESSION_SECRET=
TOKEN_HASH_SECRET=
CRON_SECRET=

# ── URL pública de la app (sin barra final). En Vercel: https://<tu-dominio> ─
APP_URL=http://localhost:3000

# ── Acceso del equipo (Microsoft Entra ID / OAuth, restringido a @haptica.co) ─
ADMIN_ALLOWED_DOMAIN=haptica.co
# Opcional: lista blanca adicional de correos (separados por coma). Vacío = cualquier cuenta del dominio/tenant.
ADMIN_EMAILS=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# SOLO desarrollo local: permite entrar al panel escribiendo un correo @haptica.co sin Microsoft. Se ignora si NODE_ENV=production.
ADMIN_DEV_LOGIN=true

# ── Prueba ────────────────────────────────────────────────────────────────
TEST_DURATION_MINUTES=90
INVITE_VALID_HOURS=24
WRITE_GRACE_SECONDS=10

# ── Textos legales (pendientes de definir con Jurídico) ───────────────────
# URL de la política de tratamiento de datos personales de Háptica.
PRIVACY_POLICY_URL=
# Retención de datos en días. VACÍO por defecto: debe definirse con Jurídico antes de usar con candidatos reales.
DATA_RETENTION_DAYS=
